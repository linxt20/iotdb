# Copy only to an isolated test deployment. The runner never writes or restarts this deployment.
# The candidate and control must be distinct endpoints and retain their exact copied files.
degree_of_query_parallelism=4
enable_dop_estimation=false

# Candidate only: both values are required by run_multisource_hash_groupby_e2e.py.
enable_property_driven_planning=true
enable_table_group_by_hash_repartition=true
table_group_by_hash_repartition_partition_count=2

# The control is identical except both enable_* flags above are false. Keep its partition count
# equal to the candidate's value so the archived difference is only planner selection.
